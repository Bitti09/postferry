{
	"name": "postferry",
	"version": "0.1.0",
	"description": "Unofficial, zero-runtime-dependency client for the Tumblr API v2 and Neue Post Format (NPF).",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"API-COVERAGE.md"
	],
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc -p tsconfig.json",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "npm test",
		"prepack": "npm run build",
		"prepare": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"typescript": "~6.0.3"
	},
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"npf",
		"tumblr-api",
		"oauth1",
		"oauth2",
		"feed-client",
		"unofficial"
	],
	"publishConfig": {
		"access": "public"
	},
	"author": "postferry contributors",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Bitti09/postferry.git"
	},
	"homepage": "https://github.com/Bitti09/postferry#readme",
	"bugs": {
		"url": "https://github.com/Bitti09/postferry/issues"
	}
}
